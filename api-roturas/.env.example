# Datos de conexion a la base de datos corporativa (Azure Database for
# PostgreSQL). Copiar este archivo a ".env" y llenar los valores reales —
# el ".env" real NUNCA se sube a git. Estos valores los entrega Tecnologia
# a traves de su mecanismo seguro de secretos (ver informe tecnico), no
# deben quedar escritos aqui ni en ningun otro archivo del repositorio.
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# Esquema corporativo donde viven las tablas usuarios/registros. La conexion
# NO trae este esquema en su search_path por defecto, asi que la API lo usa
# para calificar cada consulta explicitamente (ej. "progreso.usuarios").
PGSCHEMA=progreso

# Puerto en el que corre esta API (Tecnologia puede cambiarlo segun su
# infraestructura, por ejemplo si Azure App Service asigna otro puerto via
# la variable de entorno PORT).
PORT=3001

# Lista de origenes permitidos para llamar esta API, separados por coma.
# En el piloto se puede dejar "*" (cualquiera); en produccion conviene
# restringirlo a los dominios/apps reales.
CORS_ORIGIN=*

# Almacenamiento de evidencias (foto del suceso, foto del conciliador,
# firma) en un contenedor privado de Azure Blob Storage. La cadena de
# conexion tambien la entrega Tecnologia junto con los demas secretos —
# nunca debe quedar escrita en este archivo ni en el repositorio.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=evidencias-roturas

# Minutos de vigencia de la URL temporal que se genera para mostrar una
# evidencia en el detalle de un registro (el contenedor es privado; nunca
# se expone una URL publica ni permanente).
EVIDENCIA_URL_EXPIRA_MINUTOS=10
