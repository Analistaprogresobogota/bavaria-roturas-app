# Datos de conexion a la base de datos de Tecnologia (Azure Database for
# PostgreSQL). Copiar este archivo a ".env" y llenar los valores reales —
# el ".env" real NUNCA se sube a git.
PGHOST=svr-dba-ienm.postgres.database.azure.com
PGPORT=5432
PGDATABASE=dbgroot
PGUSER=userprog
PGPASSWORD=

# Puerto en el que corre esta API (Tecnologia puede cambiarlo segun su
# infraestructura, por ejemplo si Azure App Service asigna otro puerto via
# la variable de entorno PORT).
PORT=3001

# Lista de origenes permitidos para llamar esta API, separados por coma.
# En el piloto se puede dejar "*" (cualquiera); en produccion conviene
# restringirlo a los dominios/apps reales.
CORS_ORIGIN=*
