# Copia este archivo a ".env" y completa con los valores de tu proyecto Supabase.
# Dashboard de Supabase -> Project Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL publica de "api-roturas" (ver /api-roturas en la raiz del proyecto),
# la API propia que reemplaza a Supabase hablando con la base de datos de
# Tecnologia. Si se llena esta variable, la app usa esta API en vez de
# Supabase — dejarla vacia mientras Tecnologia no la tenga desplegada.
VITE_API_URL=

VITE_SEDE=Progreso
