# Puente temporal mientras Tecnologia no tenga la API desplegada. Una vez
# el corte a la base corporativa este aprobado (ver informe tecnico), estas
# dos variables deben quedar VACIAS en la compilacion de produccion — la app
# no debe seguir hablando con Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL publica de "api-roturas" (ver /api-roturas en la raiz del proyecto),
# la API propia que reemplaza a Supabase hablando con la base de datos de
# Tecnologia. Si se llena esta variable, la app usa esta API en vez de
# Supabase — dejarla vacia mientras Tecnologia no la tenga desplegada. Esta
# es la UNICA direccion de backend que debe llevar la compilacion de
# produccion corporativa.
VITE_API_URL=

VITE_SEDE=Progreso
